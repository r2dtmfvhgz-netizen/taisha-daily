<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taisha.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/wangdapaopaochui/taisha-daily/send_taisha_email.py</string>
    </array>

    <!-- 每天 8:30 触发 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 环境变量：QQ 邮箱授权码（必填！去 QQ邮箱→设置→账户→POP3/SMTP 获取） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>AUTH_CODE</key>
        <string>YOUR_AUTH_CODE_HERE</string>
    </dict>

    <!-- 日志输出 -->
    <key>StandardOutPath</key>
    <string>/Users/wangdapaopaochui/taisha-daily/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wangdapaopaochui/taisha-daily/stderr.log</string>

    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/wangdapaopaochui/taisha-daily</string>
</dict>
</plist>
